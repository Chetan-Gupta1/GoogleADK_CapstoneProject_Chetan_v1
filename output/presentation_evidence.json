    "slide_1": {
      "title": "NovaRetail Achieves Strong Growth Led by APAC Expansion",
      "summary": "NovaRetail total revenue reached 1280.0 million USD in 2026-Q2, representing 4.49 percent QoQ growth. Performance was led by APAC, where revenue grew 26.92 percent from 2025-Q3 to 2026-Q2. However, Latin America presents a major risk, with revenue declining by 10.0 million USD alongside deteriorating delivery times and rising fraud.",
      "icon": "globe_region.png"
    },
    "slide_2": {
      "title": "APAC and North America Drive Revenue Growth",
      "insights": [
        "APAC revenue grew 26.92 percent from 260.0 million USD to 330.0 million USD, leading all regions.",
        "North America remains our largest market, increasing revenue by 45.0 million USD to reach 465.0 million USD.",
        "Europe revenue increased 11.29 percent to 345.0 million USD, with flat marketing spend of 25.0 million USD.",
        "Latin America revenue fell 6.67 percent to 140.0 million USD, with units sold dropping by 40.0K."
      ],
      "icon": "growth_chart.png"
    },
    "slide_3": {
      "title": "Customer Satisfaction Diverges Across Key Regions",
      "insights": [
        "Mean regional NPS reached 49.75 points, with APAC leading at 62.0 points after a 4.0 point increase.",
        "Europe NPS improved by 5.0 points to 53.0, supported by delivery times dropping to 3.2 days.",
        "Latin America NPS fell by 9.0 points to 29.0, as CSAT declined from 80.0 percent to 74.0 percent.",
        "Support tickets in Latin America surged by 11.0K, reflecting growing customer friction."
      ],
      "icon": "customer_star.png"
    },
    "slide_4": {
      "title": "Supply Chain and Fraud Risks Intensify",
      "insights": [
        "Latin America delivery times rose by 2.0 days to 7.5 days, the slowest across all regions.",
        "Fraud incidents in Latin America increased from 18 to 30, representing a significant security risk.",
        "APAC warehouse capacity utilization reached 92.0 percent, raising stockout rates by 2.5 percentage points to 8.5 percent.",
        "Return processing days in APAC increased by 1.0 day, indicating emerging logistics bottlenecks."
      ],
      "icon": "risk_alert.png"
    },
    "slide_5": {
      "title": "Strategic Recommendations to Address Operational Risks",
      "recommendations": [
        "Expand APAC warehouse capacity to address the 92.0 percent utilization and reduce stockouts.",
        "Implement fraud prevention measures in Latin America to combat the rise to 30 incidents.",
        "Optimize Latin America logistics to reverse the 2.0 day increase in average delivery times.",
        "Streamline APAC return processing to reduce the 1.0 day delay and improve efficiency."
      ],
      "closing": "Addressing these operational bottlenecks will secure our growth and restore customer satisfaction across all regions.",
      "icon": "lightbulb_action.png"
    }
  }
